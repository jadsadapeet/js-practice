{
  "name": "js-practice",
  "version": "1.0.0",
  "description": "แบบฝึกหัด JavaScript พร้อม test สำหรับเช็คคำตอบเอง",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test",
    "test:01": "node --test \"exercises/01-basics/*.test.js\"",
    "test:02": "node --test \"exercises/02-strings/*.test.js\"",
    "test:03": "node --test \"exercises/03-arrays/*.test.js\"",
    "test:04": "node --test \"exercises/04-objects/*.test.js\"",
    "test:05": "node --test \"exercises/05-functions/*.test.js\"",
    "test:06": "node --test \"exercises/06-async/*.test.js\"",
    "test:review": "node --test \"review/**/*.test.js\"",
    "watch": "node --test --watch"
  },
  "engines": {
    "node": ">=22"
  }
}
